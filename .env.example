# Never paste real values into chat or commit .env.
# Production uses owner-controlled cloud secret bindings, not browser-readable config.
SHEETQMS_ENV=production
SHEETQMS_DEMO=0
# PostgreSQL + psycopg URL with TLS. Prefer a pooled endpoint; no database file in cloud.
SHEETQMS_DATABASE_URL=
# Stable Fernet key, generated privately: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHEETQMS_ENCRYPTION_KEY=
# Private R2 bucket and bucket-scoped read/write credentials; never enable public bucket access.
SHEETQMS_R2_ENDPOINT=
SHEETQMS_R2_BUCKET=
SHEETQMS_R2_ACCESS_KEY=
SHEETQMS_R2_SECRET_KEY=
# Exact app host; wildcard only where the approved provider requires it.
SHEETQMS_APP_HOSTS=
# First administrator is bootstrapped only if absent. Remove/rotate bootstrap password after setup.
SHEETQMS_ADMIN_EMAIL=
SHEETQMS_ADMIN_PASSWORD=
# Run migration explicitly before production start; do not migrate from every cold instance.
SHEETQMS_AUTO_MIGRATE=0
